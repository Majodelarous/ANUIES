# Motor de voz: gemini, nova u openai
MOTOR_VOZ=gemini

# Gemini Live (Google AI Studio)
GOOGLE_API_KEY=
# Opcional: modelo y voz. Si se deja vacío se usa el modelo por omisión de Pipecat.
GOOGLE_MODEL=
GOOGLE_VOICE_ID=Aoede
IDIOMA=es-US

# OpenAI Realtime (solo si MOTOR_VOZ=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-realtime-2.1
# Voces: marin, cedar, alloy, ash, ballad, coral, echo, sage, shimmer, verse
OPENAI_VOICE=marin

# Amazon Nova Sonic (solo si MOTOR_VOZ=nova)
# Usa AWS_PROFILE o, si se definen, las llaves de abajo.
AWS_PROFILE=Fortino-IAM-Admin
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# Voces en español: lupe (femenina) o carlos (masculina)
NOVA_VOICE_ID=lupe

# Twilio (llamadas telefónicas)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número de Twilio que hace las llamadas, formato +1...
TWILIO_NUMERO=

# WhatsApp (puente en ../whatsapp)
# Número de la asistente (el que se vincula con el QR), como referencia
WHATSAPP_ASISTENTE=
# Número de la persona con código de país, solo dígitos, por ejemplo 522221234567
WHATSAPP_PERSONA=
# Grupo de WhatsApp de la familia (nombre exacto). Ahí llegan resúmenes y alertas, y de ahí
# se toman las notas de voz y los textos que empiezan con WHATSAPP_PREFIJO para la persona.
WHATSAPP_GRUPO=
WHATSAPP_PREFIJO=abue
# Carpeta donde se guardan las notas de voz recibidas
CARPETA_AUDIOS=audios
WHATSAPP_BOT_PUERTO=7863
WHATSAPP_PUENTE_PUERTO=7864
# Carpeta de la sesión de WhatsApp, dentro de whatsapp/ (cada entorno tiene la suya)
WA_AUTH_DIR=./auth

# Imágenes parecidas (tipo Google Lens): usa GOOGLE_API_KEY para entender la imagen
# LENTE_MODELO=gemini-flash-latest
# LENTE_BUSCADOR=bing

# Conversación
# Nombre de la asistente
NOMBRE_ASISTENTE=Rous
SILENCIO_MS=900

# Datos locales
RUTA_DB=compania.db
PERSONA_ID=
